rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isLaneAdmin() {
      return request.auth != null
        && request.auth.token.email_verified == true
        && request.auth.token.email == 'wessamy2012@gmail.com';
    }

    function validFinanceEntry(data) {
      return data.keys().hasOnly([
          'type', 'category', 'amountEgp', 'occurredOn', 'paymentMethod',
          'carId', 'counterparty', 'reference', 'notes', 'status',
          'createdAt', 'voidedAt', 'voidReason'
        ])
        && data.keys().hasAll([
          'type', 'category', 'amountEgp', 'occurredOn', 'paymentMethod', 'status', 'createdAt'
        ])
        && data.type in ['income', 'expense']
        && ((data.type == 'income' && data.category in ['car-sale', 'deposit', 'commission', 'other-income'])
          || (data.type == 'expense' && data.category in ['supplier', 'operations', 'marketing', 'salaries', 'delivery', 'other-expense']))
        && data.amountEgp is number
        && data.amountEgp > 0
        && data.amountEgp <= 1000000000000
        && data.occurredOn is string
        && data.occurredOn.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
        && data.paymentMethod in ['cash', 'bank', 'wallet', 'card', 'other']
        && data.status in ['posted', 'voided']
        && data.createdAt is string
        && (!('carId' in data) || data.carId is string)
        && (!('counterparty' in data) || (data.counterparty is string && data.counterparty.size() <= 120))
        && (!('reference' in data) || (data.reference is string && data.reference.size() <= 80))
        && (!('notes' in data) || (data.notes is string && data.notes.size() <= 500))
        && (!('voidedAt' in data) || data.voidedAt is string)
        && (!('voidReason' in data) || (data.voidReason is string && data.voidReason.size() <= 160));
    }

    match /showroom_state/primary {
      allow read: if true;
      allow write: if isLaneAdmin();
    }

    match /visit_bookings/{bookingId} {
      allow create: if isLaneAdmin() || (
        request.resource.data.keys().hasOnly([
          'name', 'phone', 'carId', 'date', 'status', 'notes', 'createdAt'
        ])
        && request.resource.data.keys().hasAll([
          'name', 'phone', 'carId', 'date', 'status', 'createdAt'
        ])
        && request.resource.data.status == 'pending'
        && request.resource.data.name is string
        && request.resource.data.name.size() >= 2
        && request.resource.data.name.size() <= 120
        && request.resource.data.phone is string
        && request.resource.data.phone.size() >= 7
        && request.resource.data.phone.size() <= 30
        && request.resource.data.carId is string
        && request.resource.data.date is string
        && request.resource.data.date.size() == 10
      );
      allow read, update, delete: if isLaneAdmin();
    }

    match /finance_entries/{entryId} {
      allow read: if isLaneAdmin();
      allow create: if isLaneAdmin()
        && validFinanceEntry(request.resource.data)
        && request.resource.data.status == 'posted';
      allow update: if isLaneAdmin()
        && validFinanceEntry(request.resource.data)
        && resource.data.status == 'posted'
        && request.resource.data.status == 'voided'
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'voidedAt', 'voidReason']);
      allow delete: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
